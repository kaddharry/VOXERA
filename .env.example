# ============================================================================
# VOXERA environment variables
#
# The authoritative list (with where to find each value) is lib/env.ts; this
# file, the code and docs/VOXERA_DEPLOYMENT_RUNBOOK.md must match it, and
# __tests__/config/env-schema.test.ts checks that they do.
#
# Local development: copy to .env.local and fill in.
# Vercel: add each one in Project → Settings → Environment Variables.
# Names are CASE-SENSITIVE — always UPPER CASE exactly as written here.
#
# Not used any more (don't set them): REDIS_URL, LIVE_EVENTS_TRANSPORT,
# OPENAI_API_KEY, ANTHROPIC_API_KEY.
# ============================================================================

# ── Required ────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Twilio (Console → Account Info; number in E.164 format)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Canonical public URL of the app (no trailing slash). Twilio webhooks, the
# call stream URL and signature checks are all built from it.
VOXERA_PUBLIC_URL=https://your-app.vercel.app

# Authenticates Vercel Cron → /api/cron/dispatch. Generate: openssl rand -hex 32
CRON_SECRET=your_random_cron_secret

# Deepgram (live speech-to-text + text-to-speech on every call)
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM — at least ONE of these two. Tried in order: Groq, (Groq #2), ZenMux.
# Comma-separate several Groq keys for rotation.
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
ZENMUX_API_KEY=your_zenmux_api_key

# ── Feature-specific (only if you use the feature) ──────────────────────────

# Indian-language speech (agents whose speech provider is Gnani)
GNANI_API_KEY=
GNANI_LLM_API_KEY=
# Custom voice cloning
ELEVENLABS_API_KEY=
# Remote Hugging Face emotion models (multilingual XLM-EMO). The local ONNX
# models need no key.
HF_TOKEN=
# Encrypts tenants' saved integration credentials. Generate: openssl rand -base64 32
# If credentials were already saved without it, setting it makes them unreadable.
CREDENTIALS_ENCRYPTION_KEY=
# Email
RESEND_API_KEY=
# Comma-separated emails allowed to open /admin/tenants
PLATFORM_ADMIN_EMAILS=
# Google Calendar sync
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── Optional overrides (safe defaults; usually leave unset) ─────────────────

# Older alias of VOXERA_PUBLIC_URL (only read when that is unset)
NEXT_PUBLIC_BASE_URL=
# wss:// URL of a separate voice server — leave unset on Vercel
VOICE_STREAM_URL=
# Local development only: Test Agent WebSocket URL
NEXT_PUBLIC_REALTIME_WS_URL=
# Second Groq account's keys (separate quota), tried before ZenMux
GROQ_API_KEYS_2=
GROQ_MODEL=
CALL_LEARNING=
GNANI_STT_MIN_SILENCE_MS=
ZENMUX_BASE_URL=
ZENMUX_MODEL=
# Older alias of HF_TOKEN
HUGGINGFACE_API_KEY=
# Tenant for inbound calls to a number not assigned in Settings → Phone Numbers (default "demo")
DEFAULT_CLIENT_ID=
# "off" disables voicemail detection on follow-up calls (paid Twilio feature)
FOLLOWUP_AMD=
# "on" enables per-turn emotion diagnostics
EMOTION_LLM=
EMOTION_DIAGNOSTICS=
# Emergency switch: "false" makes a bad Twilio stream-handshake signature
# log-only instead of refused. Leave unset.
TWILIO_VALIDATE_STREAM_SIGNATURE=
