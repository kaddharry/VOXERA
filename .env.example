# ==========================================
# VOXERA Configuration File
# 1. Copy this to .env.local
# 2. Fill in the actual credentials
# ==========================================

# 1. LLM Settings — providers are tried in this order (lib/config.ts):
#    ZenMux -> Groq -> OpenAI. Leave ZENMUX_API_KEY empty to skip it and go
#    straight to Groq's existing key rotation.
ZENMUX_API_KEY=your_zenmux_api_key
# Optional overrides — only needed to change the defaults in lib/config.ts
# ZENMUX_BASE_URL=https://zenmux.ai/api/v1
# ZENMUX_MODEL=openai/gpt-4o-mini

GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
ANTHROPIC_API_KEY=your_anthropic_api_key_if_using_claude

# 1b. OpenAI (Embeddings + LLM fallback)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Deepgram (Voice STT / TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key

# 3. Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 4. Email / Integrations
RESEND_API_KEY=your_resend_api_key

# 5. Platform administration (provisional until real RBAC exists)
# Comma-separated emails allowed to view /admin/tenants (platform-wide
# tenant/subscription data). Leave unset to block the page entirely.
PLATFORM_ADMIN_EMAILS=you@voxera.example
